# SwiftFormat Rules: https://github.com/nicklockwood/SwiftFormat/blob/master/Rules.md
--allman false
--assetliterals visual-width
--beforemarks
--binarygrouping 4,8
--categorymark "MARK: %c"
--classthreshold 0
--closingparen balanced
--commas always
--conflictmarkers reject
--decimalgrouping 3,6
--elseposition next-line
--emptybraces no-space
--enumthreshold 0
--exponentcase lowercase
--exponentgrouping disabled
--extensionacl on-declarations
--extensionlength 0
--extensionmark "MARK: - %t + %c"
--fractiongrouping disabled
--fragment false
--funcattributes preserve
--groupedextension "MARK: %c"
--guardelse auto
--header "\nCopyright (c) 2011-{year} Maarten Billemont. Spectre is free software licensed under the GNU GPLv3.\n"
--hexgrouping 4,8
--hexliteralcase uppercase
--ifdef no-indent
--importgrouping testable-first
--indent 4
--indentcase true
--indentstrings true
--lifecycle
--linebreaks lf
--markextensions always
--marktypes always
--maxwidth 140
--modifierorder
--nevertrailing
--nospaceoperators
--nowrapoperators
--octalgrouping 4,8
--operatorfunc spaced
--organizetypes actor,class,enum,struct
--patternlet hoist
--ranges spaced
--redundanttype inferred
--self insert
--selfrequired
--semicolons inline
--shortoptionals always
--smarttabs enabled
--stripunusedargs unnamed-only
--structthreshold 0
--tabwidth unspecified
--trailingclosures
--trimwhitespace always
--typeattributes preserve
--typemark "MARK: - %t"
--varattributes preserve
--voidtype void
--wraparguments before-first
--wrapcollections before-first
--wrapconditions after-first
--wrapparameters preserve
--wrapreturntype if-multiline
--wrapternary before-operators
--xcodeindentation disabled
--yodaswap always
--wrapenumcases with-values
--disable wrapMultilineStatementBraces,wrapSingleLineComments,consecutiveSpaces,blankLinesBetweenChainedFunctions
#--disable spaceInsideParens,wrap,wrapArguments
--enable isEmpty
